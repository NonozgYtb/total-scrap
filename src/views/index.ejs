<%
// Fonctions utilitaires exécutées côté serveur (Node.js/EJS)

function formaterHoraires(openingHoursObj, est24h) {
    if (
        !openingHoursObj ||
        !openingHoursObj.opening_hours ||
        !Array.isArray(openingHoursObj.opening_hours)
    ) {
        return est24h
            ? '<span class="text-emerald-600 dark:text-emerald-400 font-medium">Ouvert 24h/24, 7j/7</span>'
            : '<span class="text-slate-500">Horaires non renseignés</span>';
    }

    const joursNomsCourts = {
        MONDAY: "Lun",
        TUESDAY: "Mar",
        WEDNESDAY: "Mer",
        THURSDAY: "Jeu",
        FRIDAY: "Ven",
        SATURDAY: "Sam",
        SUNDAY: "Dim",
        HOLIDAY: "Fériés",
    };

    function formaterLibelleJours(jours) {
        const aUnFerie = jours.includes("HOLIDAY");
        const joursReguliers = jours.filter((j) => j !== "HOLIDAY");
        const nomsReguliers = joursReguliers.map(
            (j) => joursNomsCourts[j] || j,
        );

        let texteRegulier = "";
        if (nomsReguliers.length >= 3) {
            texteRegulier = `${nomsReguliers[0]} à ${nomsReguliers[nomsReguliers.length - 1]}`;
        } else if (nomsReguliers.length === 2) {
            texteRegulier = aUnFerie
                ? `${nomsReguliers[0]}, ${nomsReguliers[1]}`
                : `${nomsReguliers[0]} & ${nomsReguliers[1]}`;
        } else if (nomsReguliers.length === 1) {
            texteRegulier = nomsReguliers[0];
        }

        if (aUnFerie) {
            const nomFerie = joursNomsCourts["HOLIDAY"] || "Fériés";
            return texteRegulier
                ? `${texteRegulier} & ${nomFerie}`
                : nomFerie;
        }

        return texteRegulier;
    }

    const plages = [];
    openingHoursObj.opening_hours.forEach((item) => {
        let horaireTexte = "";
        if (item.closed) {
            horaireTexte = "Fermé";
        } else if (item.slots && item.slots.length > 0) {
            horaireTexte = item.slots
                .map((s) => `${s.opens_at} - ${s.closes_at}`)
                .join(", ");
        } else {
            horaireTexte = "Ouvert";
        }

        if (
            plages.length > 0 &&
            plages[plages.length - 1].horaire === horaireTexte
        ) {
            plages[plages.length - 1].jours.push(item.day_of_week);
        } else {
            plages.push({
                jours: [item.day_of_week],
                horaire: horaireTexte,
            });
        }
    });

    return plages
        .map((p) => {
            const libelleJours = formaterLibelleJours(p.jours);
            return `<div><span class="font-medium text-slate-700 dark:text-slate-300">${libelleJours} :</span> <span class="text-slate-600 dark:text-slate-400">${p.horaire}</span></div>`;
        })
        .join("");
}
%>
<!doctype html>
<html lang="fr" class="dark">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>TotalScrap</title>

        <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="shortcut icon" href="/favicon.ico" />
        <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
        <meta name="apple-mobile-web-app-title" content="TotalScrap" />
        <link rel="manifest" href="/site.webmanifest" />

        <!-- Tailwind CSS -->
        <script src="https://cdn.tailwindcss.com"></script>
        <script>
            tailwind.config = {
                darkMode: "class",
                theme: {
                    extend: {
                        fontFamily: {
                            sans: ["Inter", "sans-serif"],
                        },
                    },
                },
            };
        </script>

        <!-- Polices & Icônes -->
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
            rel="stylesheet"
        />
        <link
            rel="stylesheet"
            href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
        />
    </head>
    <body
        class="bg-slate-50 dark:bg-slate-950 text-slate-900 dark:text-slate-100 min-h-screen font-sans antialiased pb-12 transition-colors duration-200"
    >
        <!-- EN-TÊTE PRINCIPAL -->
        <header
            class="border-b border-slate-200 dark:border-slate-800/80 bg-white/80 dark:bg-slate-900/80 sticky top-0 z-20 backdrop-blur-md px-4 py-4 transition-colors duration-200"
        >
            <div class="max-w-5xl mx-auto flex items-center gap-3">
                <div
                    class="shrink-0 w-10 h-10 rounded-xl bg-amber-500/10 border border-amber-500/30 text-amber-500 flex items-center justify-center text-lg"
                >
                    <i class="fa-solid fa-gas-pump"></i>
                </div>
                <div>
                    <h1
                        class="text-base font-bold tracking-tight text-slate-900 dark:text-white"
                    >
                        TotalScrap
                    </h1>
                    <p class="text-xs text-slate-500 dark:text-slate-400">
                        <span class="hidden sm:inline">Résultats • Mise à jour </span><%= new Date(lastFetchTime).toLocaleString("fr-FR", {
                            dateStyle: "short",
                            timeStyle: "short",
                        }) %> 
                    </p>
                </div>
                <button
                    onclick="toggleTheme()"
                    id="themeToggleBtn"
                    class="ml-auto px-3 py-2 rounded-xl bg-slate-100 hover:bg-slate-200 dark:bg-slate-900 dark:hover:bg-slate-800 border border-slate-300 dark:border-slate-800 text-slate-700 dark:text-slate-300 transition flex items-center gap-2 text-xs font-semibold"
                    title="Changer de thème"
                >
                    <i
                        id="themeIcon"
                        class="fa-solid fa-moon text-amber-500"
                    ></i>
                    <span id="themeText" class="hidden sm:inline"
                        >Mode sombre</span
                    >
                </button>
            </div>
        </header>

        <!-- CONTENU PRINCIPAL -->
        <main class="max-w-5xl mx-auto px-4 py-6 space-y-6">
            <!-- ONGLETS DE FILTRAGE -->
            <div
                class="flex flex-wrap items-center gap-2 border-b border-slate-200 dark:border-slate-800 pb-4"
            >
                <button
                    onclick="changerOnglet('TOUT')"
                    id="onglet-TOUT"
                    class="btn-onglet px-3.5 py-1.5 rounded-xl text-xs font-semibold bg-amber-500 text-slate-950 transition"
                >
                    Toutes les recherches (<%= datas.length %>)
                </button>

                <% datas.forEach(function(groupe, index) { %>
                    <button
                        onclick="changerOnglet('<%= groupe.place.slug %>')"
                        id="onglet-<%= groupe.place.slug %>"
                        class="btn-onglet px-3.5 py-1.5 rounded-xl text-xs font-semibold bg-white dark:bg-slate-900 hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-800 transition flex items-center gap-1.5"
                    >
                        <i class="fa-solid <%= groupe.place.icone %> <%= groupe.place.couleurIcone %>"></i>
                        <span><%= groupe.place.name %></span>
                    </button>
                <% }); %>
            </div>

            <!-- CONTENEUR DES RÉSULTATS -->
            <div id="conteneurResultats" class="flex flex-col gap-6">
                <% datas.forEach(function(groupe, index) { 
                    const nomPlace = groupe.place ? groupe.place.name : `Recherche ${index + 1}`;
                    const baseCoords = groupe.place ? groupe.place.coords : null;
                    const baseLat = baseCoords ? baseCoords[0] : null;
                    const baseLng = baseCoords ? baseCoords[1] : null;
                    const stations = groupe.bestPlaces || [];
                    if (stations.length === 0) return;
                %>
                    <section data-group-id="<%= groupe.place.slug %>" class="section-groupe">
                        <div class="flex items-center justify-between pb-2 border-b border-slate-200 dark:border-slate-800 mb-4">
                            <div class="flex items-center gap-2">
                                <i class="fa-solid <%= groupe.place.icone %> <%= groupe.place.couleurIcone %> text-base"></i>
                                <h2 class="text-sm font-bold tracking-wide uppercase text-slate-800 dark:text-slate-100">
                                    <%= index + 1 %>. <%= nomPlace %>
                                </h2>
                            </div>
                            <span class="text-xs font-mono text-slate-500 dark:text-slate-400">
                                <%= stations.length %> station(s)
                            </span>
                        </div>

                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <% stations.forEach(function(place) { 
                                const carburantsDisponibles = (place.products_and_services || [])
                                    .filter(prod => prod.availability_status === "AVAILABLE")
                                    .map(prod => ({
                                        nom: prod.product_name ? prod.product_name.trim() : prod.product_code,
                                        code: prod.product_code,
                                        prix: prod.price
                                    }));

                                const lng = place.coordinates ? place.coordinates[0] : 0;
                                const lat = place.coordinates ? place.coordinates[1] : 0;
                                const nomStation = place.name.startsWith("TotalEnergies")
                                    ? place.name
                                    : `TotalEnergies - ${place.name}`;

                                const distanceTexte = place.distance !== null
                                    ? place.distance < 1000
                                        ? `${Math.round(place.distance)} m`
                                        : `${(place.distance/1000).toFixed(1).replace(".", ",")} km`
                                    : null;

                                const urlGoogleMaps = `https://www.google.com/maps/search/?api=1&query=${lat},${lng}`;
                                const est24h = Boolean(place["24/7"]);
                            %>
                                <div class="bg-white dark:bg-slate-900/90 border border-slate-200 dark:border-slate-800 rounded-2xl p-4 space-y-4 hover:border-slate-300 dark:hover:border-slate-700 transition flex flex-col justify-between shadow-sm dark:shadow-none">
                                    <div class="space-y-3">
                                        <!-- En-tête station & Badge 24/7 -->
                                        <div class="flex items-start justify-between gap-3">
                                            <h3 class="text-sm font-bold text-slate-900 dark:text-white leading-snug">
                                                <%= nomStation %>
                                            </h3>
                                            <% if (est24h) { %>
                                                <span class="px-2 py-0.5 text-[10px] font-bold rounded-md bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/30 flex-shrink-0">
                                                    <i class="fa-solid fa-clock mr-1 text-[9px]"></i>24h/24
                                                </span>
                                            <% } else { %>
                                                <span class="px-2 py-0.5 text-[10px] font-semibold rounded-md bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 border border-slate-200 dark:border-slate-700 flex-shrink-0">
                                                    Horaires habituels
                                                </span>
                                            <% } %>
                                        </div>

                                        <!-- Adresse -->
                                        <p class="text-xs text-slate-600 dark:text-slate-400 flex items-start gap-1.5 leading-relaxed">
                                            <i class="fa-solid fa-location-dot text-slate-400 dark:text-slate-500 mt-0.5 text-[11px] flex-shrink-0"></i>
                                            <span><%= place.address %></span>
                                        </p>

                                        <!-- Liste des carburants -->
                                        <div class="space-y-2 pt-1">
                                            <% carburantsDisponibles.forEach(function(c) { 
                                                const aUnPrix = c.prix !== null && c.prix !== undefined;
                                                const prixFormate = aUnPrix
                                                    ? `${c.prix.toFixed(2).replace(".", ",")} €`
                                                    : "Prix non indiqué";
                                            %>
                                                <div class="flex items-center justify-between p-2.5 bg-slate-50 dark:bg-slate-950/70 rounded-xl border border-slate-200 dark:border-slate-800/80">
                                                    <div class="space-y-1">
                                                        <div class="text-xs font-semibold text-slate-800 dark:text-slate-200">
                                                            <%= c.nom %> <span class="text-[10px] text-slate-500 dark:text-slate-400 font-mono">(<%= c.code %>)</span>
                                                        </div>
                                                        <div>
                                                            <% if (aUnPrix) { %>
                                                                <span class="inline-flex items-center text-[10px] font-semibold text-emerald-600 dark:text-emerald-400 bg-emerald-500/10 px-2 py-0.5 rounded-md border border-emerald-500/20">
                                                                    <i class="fa-solid fa-circle-check mr-1 text-[9px]"></i>Disponible
                                                                </span>
                                                            <% } else { %>
                                                                <span class="inline-flex items-center text-[10px] font-semibold text-amber-600 dark:text-amber-400 bg-amber-500/10 px-2 py-0.5 rounded-md border border-amber-500/20">
                                                                    <i class="fa-solid fa-circle-question mr-1 text-[9px]"></i>Peut-être disponible
                                                                </span>
                                                            <% } %>
                                                        </div>
                                                    </div>

                                                    <div class="text-right">
                                                        <div class="text-sm font-bold font-mono <%= aUnPrix ? 'text-amber-600 dark:text-amber-400' : 'text-slate-400 dark:text-slate-500' %>">
                                                            <%= prixFormate %>
                                                        </div>
                                                        <% if (aUnPrix) { %>
                                                            <span class="text-[10px] text-slate-400 dark:text-slate-500 block">/ Litre</span>
                                                        <% } %>
                                                    </div>
                                                </div>
                                            <% }); %>
                                        </div>

                                        <!-- Horaires d'ouverture -->
                                        <div class="mt-2 pt-2.5 border-t border-slate-100 dark:border-slate-800/80 text-xs">
                                            <div class="font-semibold text-slate-700 dark:text-slate-300 flex items-center gap-1.5 mb-1.5 text-[11px]">
                                                <i class="fa-regular fa-clock text-amber-500"></i> Horaires d'ouverture :
                                            </div>
                                            <div class="pl-5 space-y-0.5 text-[11px] font-mono leading-tight">
                                                <%- formaterHoraires(place.opening_hours, est24h) %>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Pied de carte & Distance / Google Maps -->
                                    <div class="pt-3 border-t border-slate-100 dark:border-slate-800/80 flex items-center justify-between">
                                        <div class="space-y-0.5">
                                            <% if (distanceTexte) { %>
                                                <div class="text-[11px] font-semibold text-amber-600 dark:text-amber-400 flex items-center gap-1">
                                                    <i class="fa-solid fa-route text-amber-500"></i> À <%= distanceTexte %>
                                                </div>
                                            <% } %>
                                            <div class="text-[10px] text-slate-400 dark:text-slate-500 font-mono">
                                                GPS: <%= lat.toFixed(4) %>, <%= lng.toFixed(4) %>
                                            </div>
                                        </div>

                                        <a 
                                            href="<%= urlGoogleMaps %>" 
                                            target="_blank" 
                                            rel="noopener noreferrer" 
                                            class="px-3 py-1.5 bg-amber-500/10 hover:bg-amber-500/20 text-amber-700 dark:text-amber-300 border border-amber-500/30 text-xs font-semibold rounded-xl transition flex items-center gap-1.5"
                                        >
                                            <i class="fa-solid fa-diamond-turn-right text-amber-500"></i> Itinéraire Google Maps
                                        </a>
                                    </div>
                                </div>
                            <% }); %>
                        </div>
                    </section>
                <% }); %>
            </div>
        </main>

        <!-- SCRIPT CLIENT (Interactions de l'interface) -->
        <script>
            function initTheme() {
                const savedTheme = localStorage.getItem("theme");
                if (savedTheme === "light") {
                    document.documentElement.classList.remove("dark");
                } else if (savedTheme === "dark") {
                    document.documentElement.classList.add("dark");
                } else {
                    if (window.matchMedia && window.matchMedia("(prefers-color-scheme: light)").matches) {
                        document.documentElement.classList.remove("dark");
                    } else {
                        document.documentElement.classList.add("dark");
                    }
                }
                updateThemeUI();
            }

            function toggleTheme() {
                document.documentElement.classList.toggle("dark");
                const isDark = document.documentElement.classList.contains("dark");
                localStorage.setItem("theme", isDark ? "dark" : "light");
                updateThemeUI();
            }

            function updateThemeUI() {
                const isDark = document.documentElement.classList.contains("dark");
                const icon = document.getElementById("themeIcon");
                const text = document.getElementById("themeText");
                if (icon) {
                    icon.className = isDark
                        ? "fa-solid fa-sun text-amber-400"
                        : "fa-solid fa-moon text-slate-600";
                }
                if (text) {
                    text.textContent = isDark ? "Mode sombre" : "Mode clair";
                }
            }

            function changerOnglet(idOnglet) {
                document.querySelectorAll(".btn-onglet").forEach((btn) => {
                    btn.className =
                        "btn-onglet px-3.5 py-1.5 rounded-xl text-xs font-semibold bg-white dark:bg-slate-900 hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-800 transition flex items-center gap-1.5";
                });

                const btnSelectionne = document.getElementById(`onglet-${idOnglet}`);
                if (btnSelectionne) {
                    btnSelectionne.className =
                        "btn-onglet px-3.5 py-1.5 rounded-xl text-xs font-semibold bg-amber-500 text-slate-950 transition flex items-center gap-1.5";
                }

                document.querySelectorAll(".section-groupe").forEach((sec) => {
                    if (idOnglet === "TOUT" || sec.getAttribute("data-group-id") === idOnglet) {
                        sec.style.display = "block";
                    } else {
                        sec.style.display = "none";
                    }
                });
            }

            initTheme();
        </script>
    </body>
</html>